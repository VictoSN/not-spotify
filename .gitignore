# Visual Studio local workspace cache
.vs/

# OS
.DS_Store
Thumbs.db

# Bulk media ingest sources (uploaded to S3 + RDS via `dotnet run -- ingest-media`,
# not stored in git — these folders are hundreds of MB of mp4/webm)
/Music Videos/
/Podcast/
/Advertisement/

# Environment files (never commit secrets)
.env
.env.local
.env.*.local
local-dev-user-secrets.csv

# Dependencies (restored via `npm install` from the committed lockfiles)
node_modules/
frontend/public/app-preview.svg
frontend/public/favicon.svg
frontend/public/icons.svg
frontend/public/icons/
frontend/public/chat-doodle-wallpaper.svg
frontend/src/assets/fonts/
frontend/src-tauri/icons/*.png
frontend/src-tauri/icons/*.ico
frontend/src-tauri/icons/*.icns
frontend/src-tauri/icons/ios/
frontend/src-tauri/icons/android/**/*.png

# Build output
bin/
obj/
dist/
node_modules
*.zip
*.msi
*.exe
*.dmg
*.AppImage
*.deb

# Local test/build output folders that are easy to create by accident
backend/.test-bin-*/
backend/test/**/bin/
backend/test/**/obj/

# Temp / scratch build + verification output (not source)
.tmp-backend-build/
.verify/

# Local tooling caches (machine-specific, restored on demand)
.npm-cache/
.dotnet-home/
frontend/.vite/
# AI-assistant / agent tooling — never part of the project source
.claude/
.agents/
**/.claude/
**/.agents/
*.dump

# Local music library staged for one-off import (not source)
Music/

# Transient ECS task-definition written by deploy-backend.ps1 during a deploy.
# Contains the full task-def env (Stripe secret key, Google OAuth id/secret) —
# must NEVER be committed.
newtd.json
