{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=notspotify;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Issuer": "not-spotify",
    "Audience": "not-spotify-frontend",
    "SigningKey": "REPLACE_VIA_USER_SECRETS_OR_ENV_AT_LEAST_32_CHARS_LONG_PLEASE",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "LocalStorage": {
    "RootPath": "wwwroot/uploads",
    "PublicBaseUrl": "https://localhost:7080",
    "PublicUrlPrefix": "/uploads"
  }
}
