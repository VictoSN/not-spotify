VITE_USE_MOCK=false
VITE_API_URL=https://localhost:7045
# Presigned-upload Lambda behind API Gateway. There is no local emulator: point this at
# the deployed HTTP API (the deploy script prints the URL) or leave it blank, in which
# case uploads fall back to the multipart POST through the API. See docs/aws-lambda-setup.md.
VITE_UPLOADS_API_URL=
