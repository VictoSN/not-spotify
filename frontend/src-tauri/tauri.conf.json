{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "not-spotify",
  "version": "0.7.15",
  "identifier": "com.notspotify.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "not-spotify",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "zoomHotkeysEnabled": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPLOCALDATA/offline/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "Music",
    "shortDescription": "Stream music, build playlists, listen along with friends.",
    "longDescription": "not-spotify desktop — a Tauri shell that loads the not-spotify PWA in a native window."
  }
}
